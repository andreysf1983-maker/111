###################################################################################################

###################################################################################################

#    Metric.Enable
#        Описание: 1 — включить отправку метрик производительности (для Grafana/InfluxDB). 0 — выключить.
#        Значение по умолчанию: 0
Metric.Enable = 0

#    Metric.Interval
#        Описание: Интервал (в секундах) отправки метрик.
#        Значение по умолчанию: 10
Metric.Interval = 10

#    Metric.ConnectionInfo
#        Описание: Строка подключения к серверу метрик: хост;порт;база;пользователь;пароль.
#        Значение по умолчанию: "127.0.0.1;8086;worldserver"
Metric.ConnectionInfo = "127.0.0.1;8086;worldserver"

#    Metric.OverallStatusInterval
#        Описание: Интервал (в секундах) отправки общего статуса сервера в метрики.
#        Значение по умолчанию: 1
Metric.OverallStatusInterval = 1

#    PlayerBot.AccountsPerTeam
#        Описание: Число аккаунтов ботов на одну фракцию (для тестирования нагрузки).
#        Значение по умолчанию: 25
PlayerBot.AccountsPerTeam = 25

#    pbot
#        Описание: Настройка модуля ботов игроков (playerbot): базовый режим работы ботов.
#        Значение по умолчанию: 1
pbot = 1

#    pbotall
#        Описание: Настройка модуля ботов игроков: включить ботов для всех аккаунтов.
#        Значение по умолчанию: 1
pbotall = 1

#    pbotasl
#        Описание: Настройка модуля ботов игроков: автоматически входить ботами в мир при запуске.
#        Значение по умолчанию: 88
pbotasl = 88

#    pbot_hp
#        Описание: Настройка модуля ботов игроков: процент здоровья, при котором бот использует лечение.
#        Значение по умолчанию: 1
pbot_hp = 1

