#    AuctionHouseBot.Buyer.ChanceMultiplier.Orange
#        Описание: Множитель шанса покупки бота для предметов качества: оранжевых (легендарных).
#        Значение по умолчанию: 100
AuctionHouseBot.Buyer.ChanceMultiplier.Orange = 100

#    AuctionHouseBot.Buyer.ChanceMultiplier.Yellow
#        Описание: Множитель шанса покупки бота для предметов качества: жёлтых (артефактов).
#        Значение по умолчанию: 100
AuctionHouseBot.Buyer.ChanceMultiplier.Yellow = 100

#    AuctionHouseBot.Buyer.Recheck.Interval
#        Описание: Интервал (в минутах) проверки бота-покупателя на новые лоты.
#        Значение по умолчанию: 20
AuctionHouseBot.Buyer.Recheck.Interval = 20

#
###################################################################################################

###################################################################################################

#    BlackMarket.Enabled
#        Описание: 1 — включить Чёрный рынок. 0 — выключить.
#        Значение по умолчанию: 1
BlackMarket.Enabled = 1

#    BlackMarket.MaxAuctions
#        Описание: Максимальное число лотов на Чёрном рынке.
#        Значение по умолчанию: 12
BlackMarket.MaxAuctions = 12

#    BlackMarket.UpdatePeriod
#        Описание: Период (в минутах) обновления лотов Чёрного рынка.
#        Значение по умолчанию: 24
BlackMarket.UpdatePeriod = 24

#
#
###################################################################################################

###################################################################################################

#    Appender.Console
#        Описание: Вывод логов в консоль. Формат: тип,уровень,флаги. Уровень 2 — информация, 3 — отладка.
#        Значение по умолчанию: 1,3,0
Appender.Console=1,3,0

#    Appender.Server
#        Описание: Файл Server.log с основными событиями сервера. Формат: тип,уровень,флаги,имя_файла,режим.
#        Значение по умолчанию: 2,2,0,Server.log,w
Appender.Server=2,2,0,Server.log,w

#    Appender.GM
#        Описание: Файл GM.log с действиями гейм-мастеров.
#        Значение по умолчанию: 2,2,15,gm/gm_%s.log
Appender.GM=2,2,15,gm/gm_%s.log

#    Appender.DBErrors
#        Описание: Файл DBErrors.log с ошибками базы данных и данных мира.
#        Значение по умолчанию: 2,2,0,DBErrors.log
Appender.DBErrors=2,2,0,DBErrors.log

#    Appender.SQLUpdateLog
#        Описание: Файл SQLUpdates.log с журналом применения SQL-обновлений.
#        Значение по умолчанию: 2,1,16,SQLUpdate.log,w
Appender.SQLUpdateLog=2,1,16,SQLUpdate.log,w

#    Logger.root
#        Описание: Уровень логирования по умолчанию и список выводов (Console, Server).
#        Значение по умолчанию: 5,Console Server
Logger.root=5,Console Server

#    Logger.server
#        Описание: Логирование событий ядра сервера (загрузка, работа, ошибки).
#        Значение по умолчанию: 3,Console Server
Logger.server=3,Console Server

#    Logger.commands.gm
#        Описание: Логирование команд гейм-мастеров.
#        Значение по умолчанию: 3,Console GM
Logger.commands.gm=3,Console GM

#    Logger.scripts.hotswap
#        Описание: Логирование горячей перезагрузки скриптов.
#        Значение по умолчанию: 3,Console Server
Logger.scripts.hotswap=3,Console Server

#    Logger.sql.sql
#        Описание: Логирование SQL-запросов (подробно, только для отладки).
#        Значение по умолчанию: 5,Console DBErrors
Logger.sql.sql=5,Console DBErrors

#    Logger.sql.updates
#        Описание: Логирование применения SQL-обновлений баз данных.
#        Значение по умолчанию: 3,Console Server
Logger.sql.updates=3,Console Server

#    Logger.mmaps
#        Описание: Логирование загрузки и работы mmaps (навигации).
#        Значение по умолчанию: 3,Server
Logger.mmaps=3,Server

#    Log.Async.Enable
#        Описание: 1 — писать логи асинхронно (быстрее, но при аварии последние строки могут потеряться).
#        Значение по умолчанию: 0
Log.Async.Enable = 0

#    Allow.IP.Based.Action.Logging
#        Описание: 1 — записывать действия, привязанные к IP-адресу, в лог.
#        Значение по умолчанию: 0
Allow.IP.Based.Action.Logging = 0

#
###################################################################################################

###################################################################################################

#    Currency.ResetInterval
#        Описание: Интервал (в секундах) сброса недельных валют.
#        Значение по умолчанию: 7
Currency.ResetInterval = 7

#    Currency.ResetDay
#        Описание: День недели сброса валют (1 — понедельник, 0 — воскресенье).
#        Значение по умолчанию: 3
Currency.ResetDay = 3

#    Currency.ResetHour
#        Описание: Час (0–23) сброса валют.
#        Значение по умолчанию: 6
Currency.ResetHour = 6

#    Currency.StartApexisCrystals
#        Описание: Стартовое количество Кристаллов Апекса у новых персонажей.
#        Значение по умолчанию: 0
Currency.StartApexisCrystals = 0

#    Currency.MaxApexisCrystals
#        Описание: Максимальное количество Кристаллов Апекса у персонажа.
#        Значение по умолчанию: 20000
Currency.MaxApexisCrystals = 20000

#    Currency.StartJusticePoints
#        Описание: Стартовое количество Очков правосудия у новых персонажей.
#        Значение по умолчанию: 0
Currency.StartJusticePoints = 0

#    Currency.MaxJusticePoints
#        Описание: Максимальное количество Очков правосудия у персонажа.
#        Значение по умолчанию: 4000
Currency.MaxJusticePoints = 4000

#    Currency.StartArtifactKnowledge
#        Описание: Стартовый уровень знаний артефакта у новых персонажей.
#        Значение по умолчанию: 55
Currency.StartArtifactKnowledge = 55

