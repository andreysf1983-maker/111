###################################################################################################

###################################################################################################

#    PacketSpoof.Policy
#        Описание: Политика защиты от подмены пакетов: 0 — выключена, 1 — только логировать, 2 — блокировать и наказывать.
#        Значение по умолчанию: 1
PacketSpoof.Policy = 1

#    PacketSpoof.BanMode
#        Описание: Тип наказания за подмену пакетов: 0 — бан аккаунта, 1 — бан IP-адреса.
#        Значение по умолчанию: 0
PacketSpoof.BanMode = 0

#    PacketSpoof.BanDuration
#        Описание: Длительность бана (в секундах) за подмену пакетов.
#        Значение по умолчанию: 86400
PacketSpoof.BanDuration = 86400

