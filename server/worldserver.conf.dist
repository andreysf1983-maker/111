################################################
# Файл настроек игрового сервера (worldserver) — LegionForge #
################################################
[worldserver]

###################################################################################################
# ОГЛАВЛЕНИЕ
#
#    ПРИМЕР НАСТРОЙКИ
#    ПОДКЛЮЧЕНИЯ И КАТАЛОГИ
#    НАСТРОЙКИ ПРОИЗВОДИТЕЛЬНОСТИ
#    ЛОГИРОВАНИЕ СЕРВЕРА
#    НАСТРОЙКИ СЕРВЕРА
#    НАСТРОЙКИ АВТООБНОВЛЕНИЯ БАЗ ДАННЫХ
#    ГОРЯЧАЯ ПЕРЕЗАГРУЗКА СКРИПТОВ (HOTSWAP)
#    НАСТРОЙКИ ЗАЩИТЫ WARDEN
#    ВЗАИМОДЕЙСТВИЕ ИГРОКОВ
#    НАСТРОЙКИ СУЩЕСТВ (МОБОВ)
#    НАСТРОЙКИ ЧАТА
#    НАСТРОЙКИ ГЕЙМ-МАСТЕРОВ
#    НАСТРОЙКИ ТИКЕТОВ ПОДДЕРЖКИ
#    ВИДИМОСТЬ И ДИСТАНЦИИ
#    МНОЖИТЕЛИ (РЕЙТЫ) СЕРВЕРА
#    ОГРАНИЧЕНИЯ ХАРАКТЕРИСТИК
#    АВТОМАТИЧЕСКИЕ ОБЪЯВЛЕНИЯ
#    НАСТРОЙКИ ПОЛЕЙ БОЯ
#    НАСТРОЙКИ ПОЛЕЙ БИТВ (ОСАДЫ)
#    НАСТРОЙКИ АРЕН
#    НАСТРОЙКИ СЕТИ
#    КОНСОЛЬ И УДАЛЁННЫЙ ДОСТУП
#    REST-СЕРВИС МИРА
#    ПЕРЕСЫЛКА ЧАТА В DISCORD
#    УДАЛЕНИЕ ПЕРСОНАЖЕЙ
#    ОСОБЫЕ НАСТРОЙКИ LEGIONFORGE
#    НАСТРОЙКИ БОТА АУКЦИОННОГО ДОМА
#    ТОНКАЯ НАСТРОЙКА БОТА АУКЦИОНА (ПРЕДМЕТЫ)
#    НАСТРОЙКИ ПОКУПАТЕЛЯ БОТА АУКЦИОНА
#    НАСТРОЙКИ ЧЁРНОГО РЫНКА
#    НАСТРОЙКИ СИСТЕМЫ ЛОГИРОВАНИЯ
#    НАСТРОЙКИ ВАЛЮТ
#    ЗАЩИТА ОТ ПОДМЕНЫ ПАКЕТОВ
#    НАСТРОЙКИ МЕТРИК (ГРАФАНА/INFLUX)
#
###################################################################################################

###################################################################################################
# ПРИМЕР НАСТРОЙКИ
#
#    Имя_настройки = значение
#        Описание: Краткое описание того, что делает настройка.
#        Важно:    Важные замечания по настройке (если есть).
#        Пример:   Пример значения (для текстовых значений в кавычках).
#        По умолчанию: 10 - (Включено | Комментарий | Имя связанной настройки)
#                      0  - (Выключено | Комментарий | Имя связанной настройки)
#
# Примечания для разработчиков:
# - Копируйте этот пример, чтобы сохранить оформление.
# - Переносы строк делайте примерно на 100-м символе.

###################################################################################################

###################################################################################################

#    RealmID
#        Описание: Идентификатор этого игрового реалма (мира). Должен совпадать с записью в таблице realmlist базы auth.
#        Значение по умолчанию: 1
RealmID = 1

#    DataDir
#        Описание: Каталог с игровыми данными сервера (maps, vmaps, mmaps, dbc). Относительный путь считается от папки запуска.
#        Значение по умолчанию: "."
DataDir = "."

#    LogsDir
#        Описание: Каталог для лог-файлов worldserver. Он должен существовать, иначе запись логов отключается.
#        Значение по умолчанию: "logs"
LogsDir = "logs"

#    LegionLog.Enabled
#        Описание: 1 — включить журнал LegionForge (отдельный лог событий кастомных модификаций). 0 — выключить.
#        Значение по умолчанию: 1
LegionLog.Enabled = 1

#    LegionLog.Level
#        Описание: Подробность журнала LegionForge. Чем выше число, тем больше записей.
#        Значение по умолчанию: 3
LegionLog.Level = 3

#    LoginDatabaseInfo
#        Описание: Строка подключения к базе авторизации (auth): хост;порт;пользователь;пароль;база.
#        Значение по умолчанию: "127.0.0.1;3306;trinity;trinity;auth"
LoginDatabaseInfo     = "127.0.0.1;3306;trinity;trinity;auth"

#    WorldDatabaseInfo
#        Описание: Строка подключения к игровой базе мира (world): хост;порт;пользователь;пароль;база.
#        Значение по умолчанию: "127.0.0.1;3306;trinity;trinity;world"
WorldDatabaseInfo     = "127.0.0.1;3306;trinity;trinity;world"

#    CharacterDatabaseInfo
#        Описание: Строка подключения к базе персонажей (characters): хост;порт;пользователь;пароль;база.
#        Значение по умолчанию: "127.0.0.1;3306;trinity;trinity;characters"
CharacterDatabaseInfo = "127.0.0.1;3306;trinity;trinity;characters"

#    HotfixDatabaseInfo
#        Описание: Строка подключения к базе хотфиксов (hotfixes): хост;порт;пользователь;пароль;база.
#        Значение по умолчанию: "127.0.0.1;3306;trinity;trinity;hotfixes"
HotfixDatabaseInfo    = "127.0.0.1;3306;trinity;trinity;hotfixes"

#    LoginDatabase.WorkerThreads
#        Описание: Число асинхронных потоков для запросов к базе авторизации. Больше — быстрее при высокой нагрузке.
#        Значение по умолчанию: 1
LoginDatabase.WorkerThreads     = 1

#    WorldDatabase.WorkerThreads
#        Описание: Число асинхронных потоков для запросов к базе мира. Больше — быстрее при высокой нагрузке.
#        Значение по умолчанию: 1
WorldDatabase.WorkerThreads     = 1

#    CharacterDatabase.WorkerThreads
#        Описание: Число асинхронных потоков для запросов к базе персонажей. Больше — быстрее при высокой нагрузке.
#        Значение по умолчанию: 1
CharacterDatabase.WorkerThreads = 1

#    HotfixDatabase.WorkerThreads
#        Описание: Число асинхронных потоков для запросов к базе хотфиксов.
#        Значение по умолчанию: 1
HotfixDatabase.WorkerThreads    = 1

#    LoginDatabase.SynchThreads
#        Описание: Число синхронных подключений к базе авторизации (для запросов, которые нужно выполнить сразу).
#        Значение по умолчанию: 1
LoginDatabase.SynchThreads     = 1

#    WorldDatabase.SynchThreads
#        Описание: Число синхронных подключений к базе мира (для запросов, которые нужно выполнить сразу).
#        Значение по умолчанию: 1
WorldDatabase.SynchThreads     = 1

#    CharacterDatabase.SynchThreads
#        Описание: Число синхронных подключений к базе персонажей (для запросов, которые нужно выполнить сразу).
#        Значение по умолчанию: 2
CharacterDatabase.SynchThreads = 2

#    HotfixDatabase.SynchThreads
#        Описание: Число синхронных подключений к базе хотфиксов.
#        Значение по умолчанию: 1
HotfixDatabase.SynchThreads    = 1

#    MaxPingTime
#        Описание: Максимальное время (в минутах) без пинга клиента. Дольше — соединение разрывается.
#        Значение по умолчанию: 30
MaxPingTime = 30

#    WorldServerPort
#        Описание: TCP-порт игрового сервера, на который подключаются игроки (8085 — стандарт). Должен совпадать с realmlist.
#        Значение по умолчанию: 8085
WorldServerPort = 8085

#    InstanceServerPort
#        Описание: TCP-порт инстанс-сервера (подземелья, поля боя). Стандартно 8086.
#        Значение по умолчанию: 8086
InstanceServerPort = 8086

#    BindIP
#        Описание: IP-адрес, на котором слушает игровой сервер. 0.0.0.0 — все сетевые интерфейсы.
#        Значение по умолчанию: "0.0.0.0"
BindIP = "0.0.0.0"

#    ThreadPool
#        Описание: Количество потоков обработки игрового мира. Обычно равно числу физических ядер процессора.
#        Значение по умолчанию: 2
ThreadPool = 2

#    CMakeCommand
#        Описание: Команда CMake для горячей пересборки скриптов. Нужна только при разработке.
#        Значение по умолчанию: ""
CMakeCommand  = ""

#    BuildDirectory
#        Описание: Каталог сборки проекта для горячей пересборки скриптов. Нужен только при разработке.
#        Значение по умолчанию: ""
BuildDirectory  = ""

#    SourceDirectory
#        Описание: Путь к исходному коду сервера. Нужен только для горячей пересборки; для обычной работы оставьте пустым.
#        Значение по умолчанию: ""
SourceDirectory  = ""

#    MySQLExecutable
#        Описание: Путь к программе mysql.exe для автоматического применения обновлений БД. Можно оставить пустым.
#        Значение по умолчанию: ""
MySQLExecutable = ""

#
###################################################################################################

###################################################################################################

#    UseProcessors
#        Описание: Битовая маска процессорных ядер для процесса worldserver. 0 — использовать все ядра.
#        Значение по умолчанию: 0
UseProcessors = 0

#    ProcessPriority
#        Описание: Приоритет процесса в Windows: 0 — обычный, 1 — высокий.
#        Значение по умолчанию: 0
ProcessPriority = 0

#    RealmsStateUpdateDelay
#        Описание: Интервал (в секундах) обновления статуса реалма в таблице realmlist.
#        Значение по умолчанию: 10
RealmsStateUpdateDelay = 10

#    Compression
#        Описание: Уровень сжатия сетевых пакетов (от 1 до 9). Выше — меньше трафика, но больше нагрузка на процессор.
#        Значение по умолчанию: 1
Compression = 1

#    PlayerLimit
#        Описание: Максимальное число игроков, одновременно находящихся на сервере. 100 — по умолчанию.
#        Значение по умолчанию: 0
PlayerLimit = 0

#    SaveRespawnTimeImmediately
#        Описание: 1 — сохранять время возрождения мобов сразу. 0 — сохранять при выгрузке ячейки карты.
#        Значение по умолчанию: 1
SaveRespawnTimeImmediately = 1

#    MaxOverspeedPings
#        Описание: Сколько раз подряд можно прислать «слишком быстрый» пинг до разрыва соединения (защита от speedhack). 0 — отключено.
#        Значение по умолчанию: 2
MaxOverspeedPings = 2

#    GridUnload
#        Описание: 1 — выгружать из памяти неиспользуемые ячейки карты (экономит память). 0 — не выгружать.
#        Значение по умолчанию: 1
GridUnload = 1

#    BaseMapLoadAllGrids
#        Описание: 1 — загружать все ячейки основных карт сразу при старте. Сильно расходует память; 0 — загружать по мере необходимости.
#        Значение по умолчанию: 0
BaseMapLoadAllGrids = 0

#    InstanceMapLoadAllGrids
#        Описание: 1 — загружать все ячейки инстансов сразу. Расходует память; 0 — по мере необходимости.
#        Значение по умолчанию: 0
InstanceMapLoadAllGrids = 0

#    SocketTimeOutTime
#        Описание: Время простоя сокета (в миллисекундах), после которого соединение закрывается.
#        Значение по умолчанию: 900000
SocketTimeOutTime = 900000

#    SessionAddDelay
#        Описание: Задержка (в миллисекундах) между добавлением сессий игроков из очереди входа.
#        Значение по умолчанию: 10000
SessionAddDelay = 10000

#    GridCleanUpDelay
#        Описание: Задержка (в миллисекундах) перед очисткой неиспользуемых ячеек карты.
#        Значение по умолчанию: 300000
GridCleanUpDelay = 300000

#    MapUpdateInterval
#        Описание: Интервал (в миллисекундах) обновления карт (логика мира). Меньше — отзывчивее, но выше нагрузка.
#        Значение по умолчанию: 100
MapUpdateInterval = 100

#    ChangeWeatherInterval
#        Описание: Интервал (в миллисекундах) смены погоды в зонах.
#        Значение по умолчанию: 600000
ChangeWeatherInterval = 600000

#    PlayerSaveInterval
#        Описание: Интервал (в миллисекундах) автосохранения данных игроков в базу. 900000 = 15 минут.
#        Значение по умолчанию: 90000
PlayerSaveInterval = 90000

#    PlayerSave.Stats.MinLevel
#        Описание: Минимальный уровень персонажа, с которого сохраняется статистика игрока.
#        Значение по умолчанию: 0
PlayerSave.Stats.MinLevel = 0

#    PlayerSave.Stats.SaveOnlyOnLogout
#        Описание: 1 — сохранять статистику игрока только при выходе. 0 — сохранять периодически.
#        Значение по умолчанию: 1
PlayerSave.Stats.SaveOnlyOnLogout = 1

#    DisconnectToleranceInterval
#        Описание: Время (в секундах), в течение которого можно переподключиться после кратковременного разрыва связи.
#        Значение по умолчанию: 0
DisconnectToleranceInterval = 0

#    mmap.enablePathFinding
#        Описание: 1 — включить навигацию мобов по mmaps (поиск пути). Требует извлечённых mmaps.
#        Значение по умолчанию: 0
mmap.enablePathFinding = 0

#    vmap.enableLOS
#        Описание: 1 — проверка прямой видимости по vmaps (стены, здания). Требует извлечённых vmaps.
#        Значение по умолчанию: 1
vmap.enableLOS    = 1

#    vmap.enableHeight
#        Описание: 1 — точная проверка высоты поверхности по vmaps.
#        Значение по умолчанию: 1
vmap.enableHeight = 1

#    vmap.enableIndoorCheck
#        Описание: 1 — определять, находится ли игрок в помещении, по vmaps.
#        Значение по умолчанию: 1
vmap.enableIndoorCheck = 1

#    DetectPosCollision
#        Описание: 1 — проверять столкновения с геометрией при перемещении и телепортации.
#        Значение по умолчанию: 1
DetectPosCollision = 1

#    TargetPosRecalculateRange
#        Описание: Дистанция (в ярдах), при которой пересчитывается позиция цели.
#        Значение по умолчанию: 1.5
TargetPosRecalculateRange = 1.5

#    UpdateUptimeInterval
#        Описание: Интервал (в минутах) обновления времени работы сервера в таблице realmlist.
#        Значение по умолчанию: 10
UpdateUptimeInterval = 10

#    LogDB.Opt.ClearInterval
#        Описание: Интервал (в минутах) очистки таблицы логов в базе.
#        Значение по умолчанию: 10
LogDB.Opt.ClearInterval = 10

#    LogDB.Opt.ClearTime
#        Описание: Записи логов старше этого срока (в секундах) удаляются. 1209600 = 14 дней.
#        Значение по умолчанию: 1209600
LogDB.Opt.ClearTime = 1209600

#    MaxCoreStuckTime
#        Описание: Сколько секунд ядро может «зависать» до аварийного завершения (сторожевой таймер). 0 — отключено.
#        Значение по умолчанию: 0
MaxCoreStuckTime = 0

#    AddonChannel
#        Описание: 1 — разрешить канал аддонов (обмен сообщениями между аддонами). 0 — запретить.
#        Значение по умолчанию: 1
AddonChannel = 1

#    MapUpdate.Threads
#        Описание: Число потоков для обновления карт. Больше — быстрее при большом числе игроков.
#        Значение по умолчанию: 1
MapUpdate.Threads = 1

#    CleanCharacterDB
#        Описание: 1 — очищать устаревшие данные таблиц персонажей при старте сервера.
#        Значение по умолчанию: 0
CleanCharacterDB = 0

#    PersistentCharacterCleanFlags
#        Описание: Флаги очистки постоянных данных персонажей (битовая маска). 0 — ничего не очищать.
#        Значение по умолчанию: 0
PersistentCharacterCleanFlags = 0

#    Auction.GetAllScanDelay
#        Описание: Задержка (в миллисекундах) между запросами «Сканировать всё» на аукционе.
#        Значение по умолчанию: 900
Auction.GetAllScanDelay = 900

#    Auction.SearchDelay
#        Описание: Задержка (в миллисекундах) между поисковыми запросами на аукционе.
#        Значение по умолчанию: 300
Auction.SearchDelay = 300

#
###################################################################################################

###################################################################################################

#    PidFile
#        Описание: Файл, в который записывается номер процесса (PID). Пустая строка — файл не создаётся.
#        Значение по умолчанию: ""
PidFile = ""

#    PacketLogFile
#        Описание: Файл для записи сетевых пакетов (для отладки). Пустая строка — запись отключена.
#        Значение по умолчанию: ""
PacketLogFile = ""

# Extended Logging system configuration moved to end of file (on purpose)
#
###################################################################################################

###################################################################################################

#    GameType
#        Описание: Тип игрового сервера: 0 — PvE (обычный), 1 — PvP, 4 — RP-PvE, 6 — RP-PvP, 8 — FFA PvP.
#        Значение по умолчанию: 0
GameType = 0

#    RealmZone
#        Описание: Игровой регион реалма (для клиента и списка серверов). 1 — разработка/локальный сервер.
#        Значение по умолчанию: 1
RealmZone = 1

#    StrictPlayerNames
#        Описание: 1 — строгая проверка имён персонажей по правилам Blizzard. 0 — отключить проверку.
#        Значение по умолчанию: 0
StrictPlayerNames = 0

#    StrictCharterNames
#        Описание: 1 — строгая проверка названий гильдий и команд. 0 — отключить проверку.
#        Значение по умолчанию: 0
StrictCharterNames = 0

#    StrictPetNames
#        Описание: 1 — строгая проверка имён питомцев. 0 — отключить проверку.
#        Значение по умолчанию: 0
StrictPetNames = 0

#    DBC.Locale
#        Описание: Локаль данных DBC/DB2 сервера (enUS, ruRU, deDE, frFR, esES, koKR, zhCN и т.д.). Должна соответствовать клиенту.
#        Значение по умолчанию: 0
DBC.Locale = 0

#    DeclinedNames
#        Описание: 1 — разрешить склонения имён персонажей (для русского клиента). 0 — отключить.
#        Значение по умолчанию: 0
DeclinedNames = 0

#    Expansion
#        Описание: Номер дополнения, для которого работает сервер. 7 — Legion.
#        Значение по умолчанию: 6
Expansion = 6

#    MinPlayerName
#        Описание: Минимальная длина имени персонажа в символах.
#        Значение по умолчанию: 2
MinPlayerName = 2

#    MinCharterName
#        Описание: Минимальная длина названия гильдии или команды в символах.
#        Значение по умолчанию: 2
MinCharterName = 2

#    MinPetName
#        Описание: Минимальная длина имени питомца в символах.
#        Значение по умолчанию: 2
MinPetName = 2

#    Guild.CharterCost
#        Описание: Стоимость устава гильдии в медных монетах (1000000 = 100 золота).
#        Значение по умолчанию: 1000
Guild.CharterCost = 1000

#    ArenaTeam.CharterCost.2v2
#        Описание: Стоимость создания команды арены 2 на 2 (в медных монетах).
#        Значение по умолчанию: 800000
ArenaTeam.CharterCost.2v2 = 800000

#    ArenaTeam.CharterCost.3v3
#        Описание: Стоимость создания команды арены 3 на 3 (в медных монетах).
#        Значение по умолчанию: 1200000
ArenaTeam.CharterCost.3v3 = 1200000

#    ArenaTeam.CharterCost.5v5
