#    Ra.Enable
#        Описание: 1 — включить удалённую консоль (RA) для управления сервером по сети.
#        Значение по умолчанию: 0
Ra.Enable = 0

#    Ra.IP
#        Описание: IP-адрес, на котором слушает удалённая консоль (RA).
#        Значение по умолчанию: "0.0.0.0"
Ra.IP = "0.0.0.0"

#    Ra.Port
#        Описание: Порт удалённой консоли (RA). Стандартно 3443.
#        Значение по умолчанию: 3443
Ra.Port = 3443

#    Ra.MinLevel
#        Описание: Минимальный уровень доступа для входа в удалённую консоль.
#        Значение по умолчанию: 3
Ra.MinLevel = 3

#    SOAP.Enabled
#        Описание: 1 — включить SOAP-интерфейс для внешних команд. 0 — выключить.
#        Значение по умолчанию: 0
SOAP.Enabled = 0

#    SOAP.IP
#        Описание: IP-адрес SOAP-интерфейса.
#        Значение по умолчанию: "127.0.0.1"
SOAP.IP = "127.0.0.1"

#    SOAP.Port
#        Описание: Порт SOAP-интерфейса.
#        Значение по умолчанию: 7878
SOAP.Port = 7878

