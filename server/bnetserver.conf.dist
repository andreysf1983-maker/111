###############################################
# Файл настроек сервера авторизации Battle.net (bnetserver) — LegionForge #
###############################################
[bnetserver]

###################################################################################################
# ОГЛАВЛЕНИЕ
#
#    ПРИМЕР НАСТРОЙКИ
#    НАСТРОЙКИ СЕРВЕРА АВТОРИЗАЦИИ
#    НАСТРОЙКИ БАЗ ДАННЫХ (MYSQL)
#    НАСТРОЙКИ АВТООБНОВЛЕНИЯ БАЗ ДАННЫХ
#    НАСТРОЙКИ СИСТЕМЫ ЛОГИРОВАНИЯ
#
###################################################################################################

###################################################################################################
# ПРИМЕР НАСТРОЙКИ
#
#    Имя_настройки = значение
#        Описание: Краткое описание того, что делает настройка.
#        Важно:    Важные замечания по настройке (если есть).
#        Пример:   Пример значения (для текстовых значений в кавычках).
#        По умолчанию: 10 - (Включено | Комментарий | Имя связанной настройки)
#                      0  - (Выключено | Комментарий | Имя связанной настройки)
#
# Примечания для разработчиков:
# - Копируйте этот пример, чтобы сохранить оформление.
# - Переносы строк делайте примерно на 100-м символе.

###################################################################################################

###################################################################################################

#    LogsDir
#        Описание: Каталог для лог-файлов bnetserver. Он должен существовать, иначе запись логов будет отключена.
#                  По умолчанию пустая строка — логи пишутся в текущий каталог.
#        Значение по умолчанию: "logs"
LogsDir = "logs"

#    MaxPingTime
#        Описание: Максимальное время (в минутах) без пинга от клиента. Дольше — соединение разрывается.
#        Значение по умолчанию: 30
MaxPingTime = 30

#    BattlenetPort
#        Описание: TCP-порт сервера авторизации Battle.net. Клиент WoW подключается сюда для входа в аккаунт (1119 — стандарт).
#        Значение по умолчанию: 1119
BattlenetPort = 1119

#    LoginREST.Port
#        Описание: Порт REST-интерфейса авторизации (используется лаунчером и веб-входом). Стандартно 8081.
#        Значение по умолчанию: 8081
LoginREST.Port = 8081

#    LoginREST.ExternalAddress
#        Описание: Внешний адрес, который будет отдан клиенту для REST-соединения.
#                  Для игры на своём ПК — 127.0.0.1; для публичного сервера укажите внешний IP или домен.
#        Значение по умолчанию: 127.0.0.1
LoginREST.ExternalAddress=127.0.0.1

#    LoginREST.LocalAddress
#        Описание: Локальный адрес, на котором слушает REST-сервер авторизации.
#        Значение по умолчанию: 127.0.0.1
LoginREST.LocalAddress=127.0.0.1

#    LoginREST.TicketDuration
#        Описание: Срок действия билета входа (в секундах) после успешной авторизации. 3600 = 1 час.
#        Значение по умолчанию: 3600
LoginREST.TicketDuration=3600

#    BindIP
#        Описание: IP-адрес, на котором слушает bnetserver. 0.0.0.0 — все сетевые интерфейсы.
#        Значение по умолчанию: "0.0.0.0"
BindIP = "0.0.0.0"

#    PidFile
#        Описание: Файл, в который записывается номер процесса (PID). Пустая строка — файл не создаётся.
#        Значение по умолчанию: ""
PidFile = ""

#    CertificatesFile
#        Описание: Путь к SSL-сертификату (файл PEM) для шифрования соединения с клиентом.
#        Значение по умолчанию: "./bnetserver.cert.pem"
CertificatesFile = "./bnetserver.cert.pem"

#    PrivateKeyFile
#        Описание: Путь к закрытому ключу SSL (файл PEM), парному к сертификату.
#        Значение по умолчанию: "./bnetserver.key.pem"
PrivateKeyFile = "./bnetserver.key.pem"

#    SSLCertAutoGenerate
#        Описание: 1 — создавать сертификат автоматически, если файлы сертификата отсутствуют. 0 — не создавать.
#        Значение по умолчанию: 1
SSLCertAutoGenerate = 1

#    UseProcessors
#        Описание: Битовая маска процессорных ядер, на которых будет работать процесс. 0 — использовать все ядра.
#        Значение по умолчанию: 0
UseProcessors = 0

#    ProcessPriority
#        Описание: Приоритет процесса в Windows: 0 — обычный, 1 — высокий.
#        Значение по умолчанию: 0
ProcessPriority = 0

#    RealmsStateUpdateDelay
#        Описание: Интервал (в секундах) обновления статуса реалмов (серверов) в списке лаунчера.
#        Значение по умолчанию: 10
RealmsStateUpdateDelay = 10

#    WrongPass.MaxCount
#        Описание: Сколько раз подряд можно ввести неверный пароль до блокировки. 0 — блокировка отключена.
#        Значение по умолчанию: 0
WrongPass.MaxCount = 0

#    WrongPass.BanTime
#        Описание: Время блокировки (в секундах) после превышения числа неверных паролей. 600 = 10 минут.
#        Значение по умолчанию: 600
WrongPass.BanTime = 600

#    WrongPass.BanType
#        Описание: Тип блокировки: 0 — блокировать аккаунт, 1 — блокировать IP-адрес.
#        Значение по умолчанию: 0
WrongPass.BanType = 0

#    WrongPass.Logging
#        Описание: 1 — записывать неудачные попытки входа в лог. 0 — не записывать.
#        Значение по умолчанию: 0
WrongPass.Logging = 0

#    BanExpiryCheckInterval
#        Описание: Интервал (в секундах) проверки и снятия истёкших банов.
#        Значение по умолчанию: 60
BanExpiryCheckInterval = 60

#    SourceDirectory
#        Описание: Путь к исходному коду сервера. Нужен только для горячей пересборки; для обычной работы оставьте пустым.
#        Значение по умолчанию: ""
SourceDirectory  = ""

#    MySQLExecutable
#        Описание: Путь к программе mysql.exe. Нужен для автоматического применения обновлений БД; можно оставить пустым.
#        Значение по умолчанию: ""
MySQLExecutable = ""

#
###################################################################################################

###################################################################################################

#    LoginDatabaseInfo
#        Описание: Строка подключения к базе авторизации (auth) в формате: хост;порт;пользователь;пароль;база.
#        Значение по умолчанию: "127.0.0.1;3306;trinity;trinity;auth"
LoginDatabaseInfo = "127.0.0.1;3306;trinity;trinity;auth"

#    LoginDatabase.WorkerThreads
#        Описание: Число рабочих потоков для асинхронных запросов к базе авторизации.
#        Значение по умолчанию: 1
LoginDatabase.WorkerThreads = 1

#    LoginDatabase.SynchThreads
#        Описание: Число потоков для синхронных запросов к базе авторизации.
#        Значение по умолчанию: 1
LoginDatabase.SynchThreads  = 1

#
###################################################################################################

###################################################################################################

#    Updates.EnableDatabases
#        Описание: Какие базы автоматически обновлять (битовая маска): 1 — auth, 2 — characters, 4 — world, 8 — hotfixes.
#                  Например, 15 = все базы, 0 = обновления выключены.
#        Значение по умолчанию: 0
Updates.EnableDatabases = 0

#    Updates.AutoSetup
#        Описание: 1 — автоматически создавать пустую базу, если её нет. 0 — выдавать ошибку.
#        Значение по умолчанию: 1
Updates.AutoSetup   = 1

#    Updates.Redundancy
#        Описание: 1 — проверять целостность уже применённых SQL-обновлений при старте.
#        Значение по умолчанию: 1
Updates.Redundancy  = 1

#    Updates.ArchivedRedundancy
#        Описание: 1 — проверять также архивные SQL-обновления (медленнее при старте).
#        Значение по умолчанию: 0
Updates.ArchivedRedundancy = 0

#    Updates.AllowRehash
#        Описание: 1 — пересчитывать хэш SQL-обновлений, если файл был изменён.
#        Значение по умолчанию: 1
Updates.AllowRehash = 1

#    Updates.CleanDeadRefMaxCount
#        Описание: Максимальное число «мёртвых» записей обновлений, удаляемых за один запуск.
#        Значение по умолчанию: 3
Updates.CleanDeadRefMaxCount = 3

#
###################################################################################################

###################################################################################################

#    Appender.Console
#        Описание: Вывод логов в консоль. Формат: тип,уровень,флаги. Уровень 2 — информация, 3 — отладка.
#        Значение по умолчанию: 1,2,0
Appender.Console=1,2,0

#    Appender.Bnet
#        Описание: Запись логов bnetserver в файл Bnet.log. Формат: тип,уровень,флаги,имя_файла,режим (w — перезапись, a — дописывать).
#        Значение по умолчанию: 2,2,0,Bnet.log,w
Appender.Bnet=2,2,0,Bnet.log,w

#    Logger.root
#        Описание: Уровень логирования по умолчанию и список выводов (Console, Bnet). Уровень 3 — подробно.
#        Значение по умолчанию: 3,Console Bnet
Logger.root=3,Console Bnet

#    Logger.realmlist
#        Описание: Логирование списка реалмов (серверов).
#        Значение по умолчанию: 3,Console Bnet
Logger.realmlist=3,Console Bnet

#    Logger.session
#        Описание: Логирование сессий аккаунтов (входы и выходы).
#        Значение по умолчанию: 3,Console Bnet
Logger.session=3,Console Bnet

#    Logger.session.packets
#        Описание: Логирование сетевых пакетов сессий. Очень подробно — только для отладки.
#        Значение по умолчанию: 3,Console Bnet
Logger.session.packets=3,Console Bnet

#    Logger.sql.updates
#        Описание: Логирование применения SQL-обновлений баз данных.
#        Значение по умолчанию: 3,Console Bnet
Logger.sql.updates=3,Console Bnet

#    Logger.server.ssl
#        Описание: Логирование SSL-соединений и ошибок сертификатов.
#        Значение по умолчанию: 3,Console Bnet
Logger.server.ssl=3,Console Bnet

#    Logger.server.bnetserver
#        Описание: Логирование основных событий сервера авторизации bnetserver.
#        Значение по умолчанию: 3,Console Bnet
Logger.server.bnetserver=3,Console Bnet

#
###################################################################################################
